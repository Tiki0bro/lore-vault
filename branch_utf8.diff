+    visibleTerritories.forEach(t => { t.is_contested = false; });
+
+    for (let i = 0; i < visibleTerritories.length; i++) {
+      for (let j = i + 1; j < visibleTerritories.length; j++) {
+        const t1 = visibleTerritories[i];
+        const t2 = visibleTerritories[j];
