+  border-color: hsl(36, 65%, 50%);
+  box-shadow: 0 0 12px hsla(36, 60%, 42%, 0.4);
+}
+
+[data-theme="ancient-codex"] .add-to-slate-btn:disabled,
+[data-theme="ancient-codex"] .add-to-slate-btn.added {
+  background: linear-gradient(135deg, hsl(140, 40%, 35%), hsl(145, 38%, 28%));
+  border-color: hsl(140, 40%, 35%);
+}
+
+/* --- Theme: Sci-Fi Fantasy --- */
+[data-theme="scifi-fantasy"] .add-to-slate-btn {
+  background: linear-gradient(135deg, hsl(190, 90%, 45%), hsl(200, 85%, 38%));
+  border-color: hsl(190, 90%, 45%);
+}
+
+[data-theme="scifi-fantasy"] .add-to-slate-btn:hover {
