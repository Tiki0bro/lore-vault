+/* ==========================================================================
+   ADD TO SLATE READER ACTION BUTTON
+   ========================================================================== */
+.add-to-slate-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.35rem;
+  font-size: 0.8rem;
+  font-weight: 600;
+  padding: 0.4rem 0.85rem;
+  border-radius: var(--radius-sm, 6px);
+  border: 1px solid hsl(210, 80%, 50%);
+  background: linear-gradient(135deg, hsl(210, 80%, 50%), hsl(220, 75%, 42%));
+  color: #fff;
+  cursor: pointer;
+  transition: all 0.22s ease;
+  letter-spacing: 0.02em;
+  text-transform: none;
+  position: relative;
+  overflow: hidden;
+}
+
+.add-to-slate-btn:hover {
+  background: linear-gradient(135deg, hsl(210, 85%, 58%), hsl(220, 80%, 50%));
+  border-color: hsl(210, 85%, 58%);
+  box-shadow: 0 0 12px hsla(210, 80%, 50%, 0.35), var(--shadow-glow, 0 0 0 transparent);
+  transform: translateY(-1px);
+}
+
+.add-to-slate-btn:active {
+  transform: translateY(0);
+  box-shadow: 0 0 6px hsla(210, 80%, 50%, 0.2);
+}
+
+.add-to-slate-btn:disabled,
+.add-to-slate-btn.added {
+  background: linear-gradient(135deg, hsl(150, 60%, 38%), hsl(160, 55%, 32%));
+  border-color: hsl(150, 60%, 38%);
+  cursor: default;
+  opacity: 0.9;
+}
+
+.add-to-slate-btn:disabled:hover,
+.add-to-slate-btn.added:hover {
+  transform: none;
+  box-shadow: none;
+}
+
+/* Slate Pulse Animation on successful add */
+@keyframes slate-pulse {
+  0% {
+    box-shadow: 0 0 0 0 hsla(150, 70%, 50%, 0.55);
+  }
+  50% {
+    box-shadow: 0 0 14px 4px hsla(150, 70%, 50%, 0.3);
+  }
+  100% {
+    box-shadow: 0 0 0 0 hsla(150, 70%, 50%, 0);
+  }
+}
+
+.add-to-slate-btn.slate-pulse-anim {
+  animation: slate-pulse 0.65s ease-out;
+}
+
+/* --- Theme: Ancient Codex --- */
+[data-theme="ancient-codex"] .add-to-slate-btn {
+  background: linear-gradient(135deg, hsl(36, 60%, 42%), hsl(30, 55%, 34%));
+  border-color: hsl(36, 60%, 42%);
+}
+
+[data-theme="ancient-codex"] .add-to-slate-btn:hover {
